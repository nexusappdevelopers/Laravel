{
    "name": "laravel/laravel-client-showcase",
    "type": "project",
    "description": "A production-quality Laravel application demo for client showcase",
    "keywords": ["laravel", "api", "dashboard", "enterprise", "showcase"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "spatie/laravel-permission": "^6.0",
        "intervention/image": "^3.0",
        "doctrine/dbal": "^3.8",
        "league/flysystem-aws-s3-v3": "^3.25",
        "pusher/pusher-php-server": "^7.2",
        "darkaonline/l5-swagger": "^8.6",
        "knuckleswtf/scribe": "^4.38",
        "maatwebsite/excel": "^3.1",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-backup": "^8.5",
        "laravel/horizon": "^5.21",
        "laravel/socialite": "^5.14",
        "laravel/telescope": "^5.0",
        "yajra/laravel-datatables-oracle": "^10.3",
        "barryvdh/laravel-dompdf": "^2.2",
        "laravel/cashier": "^15.4",
        "stripe/stripe-php": "^13.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4",
        "laravel/dusk": "^8.0",
        "codeception/codeception": "^5.1",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "yajra/laravel-datatables-oracle": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
